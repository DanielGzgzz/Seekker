# ==============================================================================
# SYNTHETIC MARKET ANALYSIS - CREDENTIAL SETUP GUIDE
# ==============================================================================
# This file contains the environment variables needed to run the application
# with real AI and processing capabilities (disabling Mock Mode).
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env`
# 2. Fill in the empty strings with your real credentials using the guides below.
# 3. Run the app: `source .env && ./ignite.sh`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE CLOUD VERTEX AI CREDENTIALS
# ------------------------------------------------------------------------------
# We use Vertex AI (Gemini) to simulate focus groups and generate reports.
#
# How to get this:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new Project or select an existing one.
# 3. Enable the Vertex AI API for your project.
# 4. Generate a Service Account Key (JSON file):
#    - Go to IAM & Admin -> Service Accounts.
#    - Create a new service account, grant it "Vertex AI User" role.
#    - Click on it -> Keys -> Add Key -> Create new key -> JSON.
# 5. Download the JSON file, save it to this folder, and set the path below.
# ------------------------------------------------------------------------------
export GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/your/gcp-service-account-key.json"
export PROJECT_ID="your-google-cloud-project-id"
export REGION="us-central1" # Or your preferred Vertex AI region


# ------------------------------------------------------------------------------
# 2. STRIPE API CREDENTIALS (Optional for local testing)
# ------------------------------------------------------------------------------
# Needed only if you are testing the B2B API Key purchasing webhook.
#
# How to get this:
# 1. Go to the Stripe Dashboard: https://dashboard.stripe.com/
# 2. Go to Developers -> API Keys.
# 3. Copy the "Secret key" (starts with sk_test_...).
# 4. Go to Developers -> Webhooks -> Add endpoint.
# 5. Copy the "Signing secret" (starts with whsec_...).
# ------------------------------------------------------------------------------
export STRIPE_API_KEY="sk_test_YOUR_KEY_HERE"
export STRIPE_WEBHOOK_SECRET="whsec_YOUR_SECRET_HERE"


# ------------------------------------------------------------------------------
# 3. DATABASE CREDENTIALS (Optional for local testing)
# ------------------------------------------------------------------------------
# Needed only if you are deploying the backend to Google Cloud Run.
# ------------------------------------------------------------------------------
export DB_USER="postgres"
export DB_PASS="your_db_password"
export DB_NAME="synthetic_db"
export DB_HOST="127.0.0.1" # Or Cloud SQL socket path: /cloudsql/PROJECT:REGION:INSTANCE
